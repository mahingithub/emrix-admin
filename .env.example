# EMRIX admin panel. Copy to admin/.env.local for local development. On your host (e.g. Vercel),
# add the same variables in its environment settings (they're needed at build time too).

# The backend's address (no trailing slash), e.g. https://api.emrix.com
API_URL=http://localhost:3300

# The same long random secret as INTERNAL_API_KEY in the backend and storefront.
INTERNAL_API_KEY=

# The storefront's address, for "View store" links and the bundled product mockups.
NEXT_PUBLIC_SHOP_URL=http://localhost:3100
